# Neon connection string (Neon dashboard -> Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Private access code for the CMS (/admin)
ADMIN_CODE=change-me
# Long random string used to sign login tokens (openssl rand -hex 32)
JWT_SECRET=change-me
# Frontend URL(s), comma separated (CORS)
FRONTEND_URL=http://localhost:3000
# Contact-form email via Resend
RESEND_API_KEY=re_xxxxxxxx
MAIL_TO=you@gmail.com
MAIL_FROM=Portfolio <onboarding@resend.dev>
# --- Email verification + notifications: choose ONE option ---
# Option A (quickest, no domain): Gmail App Password
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-google-app-password
# Option B: Resend with a verified domain -> set MAIL_FROM to an address on that domain (RESEND_API_KEY above)
